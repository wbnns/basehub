---
import Default from '@astrojs/starlight/components/Footer.astro';
import { Icon } from '@astrojs/starlight/components';

const { entry, hasSidebar } = Astro.locals.starlightRoute;
const isDoc = !!entry?.id && entry.id !== 'index';
const url = new URL(Astro.url.pathname, Astro.site);
const markdownUrl = isDoc ? `${Astro.site}${entry.id}.md` : null;

const askPrompt = isDoc
  ? `I'm reading the BaseHub documentation page "${entry.data.title}" at ${url.href}. The raw markdown is at ${markdownUrl}. Please use it as authoritative context and help me with the following: `
  : '';

const claudeUrl = isDoc
  ? `https://claude.ai/new?q=${encodeURIComponent(askPrompt)}`
  : null;
const chatgptUrl = isDoc
  ? `https://chat.openai.com/?q=${encodeURIComponent(askPrompt)}`
  : null;
---

{isDoc && markdownUrl && (
  <aside class="bh-agent-actions" aria-label="Use this page with an AI agent">
    <span class="bh-agent-actions__label">Use with an agent</span>
    <div class="bh-agent-actions__row">
      <a class="bh-agent-actions__btn" href={markdownUrl}>View as Markdown</a>
      <a class="bh-agent-actions__btn" href={claudeUrl} target="_blank" rel="noopener">Open in Claude</a>
      <a class="bh-agent-actions__btn" href={chatgptUrl} target="_blank" rel="noopener">Open in ChatGPT</a>
      <button
        class="bh-agent-actions__btn"
        type="button"
        data-bh-copy={markdownUrl}
        aria-label="Copy Markdown URL"
      >Copy MD URL</button>
    </div>
    <p class="bh-agent-actions__hint">
      Every BaseHub page exposes raw Markdown — append <code>.md</code> to the URL. See <a href="/llms.txt">/llms.txt</a> and <a href="/llms-full.txt">/llms-full.txt</a> for the full agent index.
    </p>
  </aside>
)}

<Default><slot /></Default>

{isDoc && (
  <aside class="bh-support" aria-label="Support this site">
    <div class="bh-support__note">
      <span class="bh-support__mark" aria-hidden="true"></span>
      <div class="bh-support__lines">
        <p class="bh-support__line1">No ads, no paid placements, one maintainer.</p>
        <p class="bh-support__line2">If this page saved you time, your support helps fund BaseHub updates. 🙏</p>
      </div>
    </div>
    <div class="bh-support__actions">
      <a class="bh-support__action" href="https://github.com/sponsors/wbnns" target="_blank" rel="noopener">
        <Icon name="heart" aria-hidden="true" />
        <span>GitHub Sponsors</span>
      </a>
      <button class="bh-support__action" type="button" data-bh-copy-eth="wbnns.eth">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M11.944 17.97 4.58 13.62 11.943 24l7.37-10.38-7.372 4.35Z"></path>
          <path d="M12.056 0 4.69 12.223l7.365 4.354 7.365-4.35Z"></path>
        </svg>
        <span data-bh-copy-label>wbnns.eth</span>
      </button>
    </div>
  </aside>
)}

<aside class="bh-disclaimer" role="contentinfo" aria-label="Project disclaimer">
  <p>
    <a href="https://github.com/wbnns/basehub" target="_blank" rel="noopener">BaseHub</a> is a compendium of open resources about Base, assembled into one site, that's built for agents.
  </p>
  <p>
    Not affiliated with or endorsed by Coinbase or any related entity. <a href="https://github.com/wbnns/basehub/blob/main/LICENSE" target="_blank" rel="noopener">MIT License</a>.
  </p>
</aside>

<script>
  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null;
    const btn = target?.closest<HTMLElement>('[data-bh-copy]');
    if (!btn) return;
    const value = btn.getAttribute('data-bh-copy');
    if (!value) return;
    navigator.clipboard?.writeText(value).then(() => {
      const original = btn.textContent;
      btn.textContent = 'Copied';
      setTimeout(() => {
        if (btn.textContent === 'Copied') btn.textContent = original;
      }, 1500);
    });
  });

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null;
    const btn = target?.closest<HTMLElement>('[data-bh-copy-eth]');
    if (!btn) return;
    const value = btn.getAttribute('data-bh-copy-eth');
    const label = btn.querySelector<HTMLElement>('[data-bh-copy-label]');
    if (!value || !label) return;
    navigator.clipboard?.writeText(value).then(() => {
      const original = label.textContent;
      label.textContent = 'Copied';
      setTimeout(() => {
        if (label.textContent === 'Copied') label.textContent = original;
      }, 1600);
    });
  });

  // Search dialog empty state — when the input is empty, fill the
  // otherwise-blank modal with curated quick links so it never reads as
  // a wall of whitespace.
  const EMPTY_STATE_HTML = `
    <div class="bh-search-empty__col">
      <h3>Popular pages</h3>
      <ul>
        <li><a href="/network/base-contracts/">Base contracts</a></li>
        <li><a href="/network/network-fees/">Fee model</a></li>
        <li><a href="/network/diffs-ethereum-base/">Base vs. Ethereum</a></li>
        <li><a href="/network/bridges/">Bridges</a></li>
        <li><a href="/network/network-faucets/">Faucets</a></li>
        <li><a href="/node-operations/node-providers/">Node providers</a></li>
      </ul>
    </div>
    <div class="bh-search-empty__col">
      <h3>For agents</h3>
      <ul>
        <li><a href="/llms.txt"><code>/llms.txt</code></a></li>
        <li><a href="/llms-full.txt"><code>/llms-full.txt</code></a></li>
        <li><a href="/api/pages.json"><code>/api/pages.json</code></a></li>
        <li><a href="https://www.npmjs.com/package/@wbnns/base-mcp">MCP server</a></li>
        <li><a href="/feeds/blog.xml"><code>/feeds/blog.xml</code></a></li>
        <li><a href="/feeds/status.xml"><code>/feeds/status.xml</code></a></li>
      </ul>
    </div>
  `;

  const wireDialog = (dialog: HTMLDialogElement) => {
    const frame = dialog.querySelector('.dialog-frame');
    if (!frame) return false;
    let panel = frame.querySelector<HTMLDivElement>('.bh-search-empty');
    if (!panel) {
      panel = document.createElement('div');
      panel.className = 'bh-search-empty';
      panel.innerHTML = EMPTY_STATE_HTML;
      frame.appendChild(panel);
    }
    const input = dialog.querySelector<HTMLInputElement>('.pagefind-ui__search-input');
    if (input && !input.dataset.bhWired) {
      input.dataset.bhWired = '1';
      const sync = () => {
        const isEmpty = input.value.trim() === '';
        dialog.toggleAttribute('data-bh-empty', isEmpty);
      };
      input.addEventListener('input', sync);
      input.addEventListener('focus', sync);
      sync();
    } else if (!input) {
      // Pagefind hasn't mounted yet — keep the empty state visible by default.
      dialog.setAttribute('data-bh-empty', '');
    }
    return !!input;
  };

  document.querySelectorAll<HTMLElement>('site-search').forEach((el) => {
    const dialog = el.querySelector<HTMLDialogElement>('dialog');
    if (!dialog) return;
    wireDialog(dialog);
    const observer = new MutationObserver(() => {
      if (wireDialog(dialog)) {
        // Once the input is wired we still want to keep observing for
        // cases where the dialog frame is replaced, so do not disconnect.
      }
    });
    observer.observe(dialog, { childList: true, subtree: true });
  });
</script>

<style>
  .bh-agent-actions {
    margin: 2.5rem 0 1.5rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 10px;
    background: var(--sl-color-gray-7, #f5f6f8);
  }
  .bh-agent-actions__label {
    display: block;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sl-color-gray-2);
    margin-bottom: 0.625rem;
  }
  .bh-agent-actions__row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .bh-agent-actions__btn {
    display: inline-flex;
    align-items: center;
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 6px;
    background: var(--sl-color-bg, #fff);
    color: var(--sl-color-text);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.2;
    text-decoration: none;
    cursor: pointer;
    transition: border-color 120ms ease, color 120ms ease;
  }
  .bh-agent-actions__btn:hover {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent);
  }
  .bh-agent-actions__hint {
    margin: 0.75rem 0 0;
    font-size: 0.8125rem;
    color: var(--sl-color-gray-2);
  }
  .bh-agent-actions__hint code {
    font-size: 0.8125em;
  }
  .bh-support {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 2rem 0 0;
    padding: 0.875rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 8px;
    background: var(--sl-color-gray-7, #f5f6f8);
  }
  .bh-support__note {
    display: flex;
    align-items: stretch;
    gap: 0.625rem;
  }
  .bh-support__mark {
    flex: none;
    width: 2px;
    align-self: stretch;
    border-radius: 1px;
    background: var(--sl-color-accent);
  }
  .bh-support__lines {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .bh-support__line1 {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.4;
    color: var(--sl-color-text);
  }
  .bh-support__line2 {
    margin: 0;
    font-size: 0.71875rem;
    line-height: 1.5;
    color: color-mix(in srgb, var(--sl-color-text) 58%, transparent);
  }
  .bh-support__actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }
  .bh-support__action {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.4375rem;
    height: 2.375rem;
    padding: 0 0.75rem;
    border: 1px solid color-mix(in srgb, var(--sl-color-accent) 45%, transparent);
    border-radius: 8px;
    background: transparent;
    color: var(--sl-color-accent);
    font-size: 0.78125rem;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition: border-color 120ms ease, background-color 120ms ease;
  }
  .bh-support__action:hover {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent-tint);
  }
  .bh-support__action:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  .bh-support__action :global(svg) {
    flex: none;
    width: 0.875rem;
    height: 0.875rem;
  }
  .bh-support__action span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .bh-support__action[data-bh-copy-eth] span {
    font-family: var(--sl-font-mono);
  }
  @media (max-width: 30rem) {
    .bh-support__actions {
      grid-template-columns: 1fr;
    }
    .bh-support__action {
      height: 2.75rem;
    }
  }
  .bh-disclaimer {
    margin-top: 2rem;
    padding: 0.875rem 0;
    border-top: 1px solid var(--sl-color-hairline-light);
    font-size: 0.8125rem;
    color: var(--sl-color-gray-3);
    line-height: 1.5;
  }
  .bh-disclaimer p {
    margin: 0;
  }
  .bh-disclaimer strong {
    color: var(--sl-color-gray-2);
    font-weight: 600;
  }
  .bh-disclaimer a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }
  .bh-disclaimer a:hover {
    color: var(--sl-color-accent);
  }
</style>
