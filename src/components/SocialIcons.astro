---
import Default from '@astrojs/starlight/components/SocialIcons.astro';
import { Icon } from '@astrojs/starlight/components';
---

<Default />
<a
  class="bh-support-link"
  href="https://github.com/sponsors/wbnns"
  target="_blank"
  rel="noopener"
  aria-label="Support the maintainer via GitHub Sponsors"
>
  <Icon name="heart" aria-hidden="true" />
  <span class="bh-support-link__label" aria-hidden="true">Support</span>
</a>

<style>
  .bh-support-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0 0.75rem;
    border: 1px solid color-mix(in srgb, var(--sl-color-accent) 45%, transparent);
    border-radius: 8px;
    background: transparent;
    color: var(--sl-color-accent);
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: none;
    transition: border-color 120ms ease, background-color 120ms ease, color 120ms ease;
  }
  .bh-support-link:hover {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent-tint);
  }
  .bh-support-link:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  .bh-support-link :global(svg) {
    flex: none;
  }

  /* Header gets crowded well before the site title's own breakpoints —
     collapse to an icon-only target; the aria-label already covers it. */
  @media (max-width: 64rem) {
    .bh-support-link__label {
      display: none;
    }
    .bh-support-link {
      padding: 0;
    }
  }

  /* Starlight hides the whole .right-group below `md` (50rem) since it
     normally only carries the theme/language switches, both no-ops on
     this site. The Support link is the one thing in there that must
     survive down to mobile, so re-show it (and only it) explicitly. */
  @media (max-width: 49.999rem) {
    :global(.right-group) {
      display: flex !important;
    }
    :global(.right-group > :not(.social-icons)) {
      display: none !important;
    }
  }
</style>
